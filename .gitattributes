# Repository-owned Linux guest text; never normalize arbitrary user artifacts.
/examples/**/*.sh text eol=lf
/examples/**/sample-cli text eol=lf
/examples/**/comparison-cli text eol=lf
/examples/mcp/assets/codex-settings-prefix.txt text eol=lf
/examples/plugins/*.toml.in text eol=lf
/examples/plugins/fixture/**/*.json text eol=lf
/examples/plugins/fixture/**/*.md text eol=lf
/tests/fixtures/**/*.sh text eol=lf
/tests/fixtures/**/sample-cli text eol=lf
/tests/fixtures/plugins/replay-client text eol=lf
# Recipe fixtures are Linux guest contracts and exact multiline test templates.
/tests/fixtures/recipes/*.toml text eol=lf

# Preserve exact upstream archive bytes across native checkouts.
vendor/crossterm/** -text

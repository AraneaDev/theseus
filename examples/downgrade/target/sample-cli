#!/bin/sh
set -eu
data=$XDG_DATA_HOME/sample-cli/records
settings=$XDG_CONFIG_HOME/sample-cli/settings
case "${1:---version}" in
--version) echo 'sample-cli 2.0.0' ;;
configure)
    mkdir -p "${settings%/*}" "${data%/*}"
    printf 'colour=blue\n' > "$settings"
    printf 'format=2\nalpha=11\n' > "$data"
    ;;
smoke)
    if test "$(wc -l < "$data")" -eq 2; then printf 'beta=29\n' >> "$data"; fi
    "$0" read-data
    ;;
read-data)
    test "$(cat "$settings")" = colour=blue
    test "$(cat "$data")" = "$(printf 'format=2\nalpha=11\nbeta=29')"
    cat "$data"
    awk -F= 'NR>1 {n++; sum+=$2} END {printf "new-reader records=%d sum=%d\n",n,sum}' "$data"
    printf 'runtime uid=%s gid=%s\n' "$(id -u)" "$(id -g)"
    ;;
*) exit 2 ;;
esac

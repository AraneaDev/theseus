# Generated only by prepare.py into a new private output directory.
schema_version = 7
name = "Local Claude plugin lifecycle (local)"
image = @@IMAGE_JSON@@
network = "none"
scenarios = ["plugin_lifecycle"]
observe = ["/workspace", "/home/theseus/plugin-config"]
[artifacts]
target = "target"
[profiles.user.plugin]
id = "theseus-probe@theseus-probe-market"
scope = "local"
base_version = "1.0.0"
target_version = "2.0.0"
client_version = @@CLIENT_VERSION_JSON@@
client_check = "client-version"
client_artifact = "client/claude"
[profiles.user.plugin.checkpoints.base_installed]
inventory = "base-inventory"
preservation = ["base-user-settings", "base-scope-settings"]
components = ["base-components"]
[profiles.user.plugin.checkpoints.target_installed]
inventory = "target-inventory"
preservation = ["target-user-settings", "target-scope-settings"]
components = ["target-components"]
[profiles.user.plugin.checkpoints.plugin_disabled]
inventory = "disabled-inventory"
preservation = ["disabled-user-settings", "disabled-scope-settings"]
components = []
[profiles.user.plugin.checkpoints.plugin_enabled]
inventory = "enabled-inventory"
preservation = ["enabled-user-settings", "enabled-scope-settings"]
components = []
[profiles.user.plugin.checkpoints.uninstalled]
inventory = "removed-inventory"
preservation = ["removed-user-settings", "removed-scope-settings", "removed-installed-records"]
components = []
[profiles.user.steps.install_base]
script = "sh /inputs/target/lifecycle.sh install_base local"
timeout_seconds = 45
[profiles.user.steps.upgrade]
script = "sh /inputs/target/lifecycle.sh upgrade local"
timeout_seconds = 45
[profiles.user.steps.disable_plugin]
script = "sh /inputs/target/lifecycle.sh disable_plugin local"
timeout_seconds = 45
[profiles.user.steps.enable_plugin]
script = "sh /inputs/target/lifecycle.sh enable_plugin local"
timeout_seconds = 45
[profiles.user.steps.uninstall]
script = "sh /inputs/target/lifecycle.sh uninstall local"
timeout_seconds = 45
[[profiles.user.checks]]
id = "client-version"
checkpoint = "base_installed"
kind = "json_command"
script = "sh /inputs/target/client-version.sh"
expected_exit = 0
timeout_seconds = 20
max_stdout_bytes = 16384
assertions = [
  { kind = "equals", pointer = "/version", equals_json = @@CLIENT_VERSION_SCALAR_JSON@@ }
]
[[profiles.user.checks]]
id = "base-inventory"
checkpoint = "base_installed"
kind = "json_command"
script = "sh /inputs/target/lifecycle.sh inventory local"
expected_exit = 0
timeout_seconds = 20
max_stdout_bytes = 16384
assertions = [
  { kind = "array_match", pointer = "", identity = [{ pointer = "/id", equals_json = "\"theseus-probe@theseus-probe-market\"" }], count = 1, values = [{ pointer = "/scope", equals_json = "\"local\"" }, { pointer = "/version", equals_json = "\"1.0.0\"" }, { pointer = "/enabled", equals_json = "true" }, { pointer = "/installPath", equals_json = "\"/home/theseus/plugin-config/plugins/cache/theseus-probe-market/theseus-probe/1.0.0\"" }, { pointer = "/readFromFolder", equals_json = "\"/workspace/local-market/plugins/theseus-probe\"" }, { pointer = "/folderVersion", equals_json = "\"1.0.0\"" }, { pointer = "/projectPath", equals_json = "\"/workspace/plugin-project\"" }] },
  { kind = "array_match", pointer = "", identity = [{ pointer = "/id", equals_json = "\"theseus-companion@theseus-probe-market\"" }], count = 1, values = [{ pointer = "/scope", equals_json = "\"user\"" }, { pointer = "/version", equals_json = "\"1.0.0\"" }, { pointer = "/enabled", equals_json = "true" }, { pointer = "/installPath", equals_json = "\"/home/theseus/plugin-config/plugins/cache/theseus-probe-market/theseus-companion/1.0.0\"" }, { pointer = "/readFromFolder", equals_json = "\"/workspace/local-market/plugins/theseus-companion\"" }, { pointer = "/folderVersion", equals_json = "\"1.0.0\"" }] }
]
[[profiles.user.checks]]
id = "base-user-settings"
checkpoint = "base_installed"
kind = "json_command"
script = "sh /inputs/target/lifecycle.sh user-settings local"
expected_exit = 0
timeout_seconds = 20
max_stdout_bytes = 16384
assertions = [
  { kind = "equals", pointer = "/env/THESEUS_UNRELATED", equals_json = "\"keep-me\"" },
  { kind = "equals", pointer = "/env/THESEUS_SECOND", equals_json = "\"still-here\"" },
  { kind = "equals", pointer = "/enabledPlugins/theseus-companion@theseus-probe-market", equals_json = "true" }
]
[[profiles.user.checks]]
id = "base-scope-settings"
checkpoint = "base_installed"
kind = "json_command"
script = "sh /inputs/target/lifecycle.sh scope-settings local"
expected_exit = 0
timeout_seconds = 20
max_stdout_bytes = 16384
assertions = [
  { kind = "equals", pointer = "/env/THESEUS_UNRELATED", equals_json = "\"keep-me\"" },
